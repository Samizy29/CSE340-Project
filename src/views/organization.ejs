<%- include('partials/header') %>
<main>
    <h1><%= organizationDetails.name %></h1>

    <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">

    <p><%= organizationDetails.description %></p>
    <p>
        <strong>Contact:</strong>
        <a href="mailto:<%= organizationDetails.contact_email %>"><%= organizationDetails.contact_email %></a>
    </p>

    <h2>Service Projects</h2>
    <% if (projects.length > 0) { %>
        <ul>
            <% projects.forEach(project => { %>
                <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>This organization has no service projects yet.</p>
    <% } %>

    <p><a href="/organizations">Back to all organizations</a></p>
</main>
<%- include('partials/footer') %>