<%- include('partials/header') %>
<main>
    <h2><%= projectDetails.title %></h2>

    <p><%= projectDetails.description %></p>

    <p>
        <strong>Date:</strong>
        <%= new Date(projectDetails.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
    </p>

    <p><strong>Location:</strong> <%= projectDetails.location %></p>

    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a>
    </p>

    <% if (categories.length > 0) { %>
        <section>
            <h3>Categories</h3>
            <ul class="category-tags">
                <% categories.forEach(category => { %>
                    <li>
                        <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                    </li>
                <% }); %>
            </ul>
        </section>
    <% } %>
</main>
<%- include('partials/footer') %>